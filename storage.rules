rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // User profile photos - owner can read/write
    match /profile-photos/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // CV template thumbnails - authenticated users can read, admins can write
    match /template-thumbnails/{templateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Portfolio template assets - authenticated users can read, admins can write
    match /portfolio-assets/{templateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // User uploaded assets - owner can read/write
    match /user-assets/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
